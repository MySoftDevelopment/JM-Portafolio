---
import { Footer, Navbar } from '@components/views/inicio';
import Base from '@/layouts/Base.astro';
---

<Base title='Página no encontrada | Juan Molina' description='Esta página no existe. Vuelve al inicio o al blog de Juan Molina.' path='/404.html' noindex>
    <Navbar client:load pagina='otra' />
    <main id='contenido' class='container-page flex min-h-[70vh] flex-col items-start justify-center pb-24 pt-36'>
        <p class='kicker mb-8'>Error 404</p>
        <h1 class='text-[2.9rem] font-semibold leading-[0.98] tracking-[-0.035em] sm:text-[4.2rem]'>
            Michi se llevó <em class='not-italic text-sand'>esta página</em>
        </h1>
        <p class='mt-8 max-w-[46ch] text-[17px] leading-relaxed text-muted'>La dirección no existe o cambió de lugar.</p>
        <div class='mt-10 flex flex-wrap gap-5'>
            <a href='/' class='btn-primary'>Volver al inicio</a>
            <a href='/blog/' class='btn-ghost'>Ir al blog</a>
        </div>
    </main>
    <Footer pagina='blog' />
</Base>
