---
import { Footer } from '@components/views/inicio/views/Footer';
import { Navbar } from '@components/views/inicio/views/Navbar';
import ListaEntradas from '@components/views/blog/ListaEntradas.astro';
import NavCategorias from '@components/views/blog/NavCategorias.astro';
import Base from '@/layouts/Base.astro';
import { entradasPublicadas } from '@/lib/entradas';

const entradas = await entradasPublicadas();

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': 'https://juanmolina.dev/blog/#blog',
    url: 'https://juanmolina.dev/blog/',
    name: 'Blog de Juan Molina',
    description: 'Vulnerabilidades, lanzamientos y cambios en PHP, Node.js, React y TypeScript, explicados para quien tiene que actualizar su proyecto.',
    inLanguage: 'es-CO',
    author: { '@id': 'https://juanmolina.dev/#persona' },
    blogPost: entradas.map((e) => ({
        '@type': 'BlogPosting',
        headline: e.data.titulo,
        url: `https://juanmolina.dev/blog/${e.id}/`,
        datePublished: e.data.fecha.toISOString(),
    })),
};
---

<Base title='Blog | Juan Molina, desarrollador fullstack' description='Vulnerabilidades, lanzamientos y cambios en PHP, Node.js, React y TypeScript, explicados con lo que tienes que hacer en tu proyecto.' path='/blog/' jsonLd={jsonLd} anuncios>
    <Navbar client:idle pagina='blog' />
    <main id='contenido' class='pb-24 pt-28 md:pb-36 md:pt-36'>
        <div class='container-page'>
            <header class='max-w-3xl'>
                <p class='kicker mb-8'>Blog</p>
                <h1 class='text-[2.9rem] font-semibold leading-[0.98] tracking-[-0.035em] sm:text-[4.2rem]'>
                    Lo que pasa en mi <em class='not-italic text-sand'>stack</em>
                </h1>
                <p class='mt-8'>
                    <a href='/rss.xml' class='font-mono text-[11px] uppercase tracking-[0.14em] text-muted underline decoration-line-strong underline-offset-4 transition-colors hover:text-ink'>Suscríbete por RSS</a>
                </p>
            </header>

            <NavCategorias />
            {entradas.length === 0 ? <p class='mt-16 text-muted'>Pronto habrá entradas aquí.</p> : <ListaEntradas entradas={entradas} />}
        </div>
    </main>
    <Footer pagina='blog' />
</Base>
