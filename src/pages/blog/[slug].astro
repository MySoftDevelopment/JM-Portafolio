---
import { Footer, Navbar } from '@components/views/inicio';
import Base from '@/layouts/Base.astro';
import { REVISION } from '@/data/portfolio';
import { CATEGORIAS, fechaLarga } from '@/lib/blog';
import { entradasPublicadas, type Entrada } from '@/lib/entradas';
import { render } from 'astro:content';

export async function getStaticPaths() {
    const entradas = await entradasPublicadas();
    return entradas.map((entrada) => ({ params: { slug: entrada.id }, props: { entrada, otras: entradas.filter((e) => e.id !== entrada.id).slice(0, 2) } }));
}

interface Props {
    entrada: Entrada;
    otras: Entrada[];
}

const { entrada, otras } = Astro.props;
const { titulo, descripcion, fecha, actualizado, categoria, etiquetas, fuentes } = entrada.data;
const { Content } = await render(entrada);

const pesos = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
const path = `/blog/${entrada.id}/`;
const url = new URL(path, Astro.site).href;
const minutos = Math.max(1, Math.round((entrada.body ?? '').split(/\s+/).length / 220));

const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'BlogPosting',
            '@id': `${url}#entrada`,
            headline: titulo,
            description: descripcion,
            url,
            mainEntityOfPage: url,
            datePublished: fecha.toISOString(),
            dateModified: (actualizado ?? fecha).toISOString(),
            inLanguage: 'es-CO',
            image: 'https://juanmolina.dev/images/og-image.jpg',
            keywords: etiquetas.join(', '),
            articleSection: CATEGORIAS[categoria],
            author: { '@id': 'https://juanmolina.dev/#persona' },
            publisher: { '@id': 'https://juanmolina.dev/#persona' },
            isPartOf: { '@id': 'https://juanmolina.dev/blog/#blog' },
            citation: fuentes.map((f) => f.url),
        },
        {
            '@type': 'Person',
            '@id': 'https://juanmolina.dev/#persona',
            name: 'Juan Molina',
            url: 'https://juanmolina.dev/',
            jobTitle: 'Desarrollador Fullstack',
        },
        {
            '@type': 'BreadcrumbList',
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://juanmolina.dev/' },
                { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://juanmolina.dev/blog/' },
                { '@type': 'ListItem', position: 3, name: titulo, item: url },
            ],
        },
    ],
};
---

<Base title={`${titulo} | Juan Molina`} description={descripcion} path={path} type='article' jsonLd={jsonLd} published={fecha.toISOString()} modified={(actualizado ?? fecha).toISOString()} anuncios>
    <Navbar client:load pagina='blog' />
    <main id='contenido' class='pb-24 pt-28 md:pb-36 md:pt-36'>
        <article class='container-page'>
            <header class='mx-auto max-w-[72ch]'>
                <nav aria-label='Ruta' class='font-mono text-[11px] uppercase tracking-[0.14em] text-faint'>
                    <a href='/blog/' class='transition-colors hover:text-ink'>Blog</a>
                    <span class='mx-2' aria-hidden='true'>/</span>
                    <span class='text-accent'>{CATEGORIAS[categoria]}</span>
                </nav>
                <h1 class='mt-6 text-[2.3rem] font-semibold leading-[1.05] tracking-[-0.035em] md:text-[3.4rem]'>{titulo}</h1>
                <p class='mt-6 text-lg leading-relaxed text-muted md:text-xl'>{descripcion}</p>
                <p class='mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-line pb-8 font-mono text-[11px] uppercase tracking-[0.14em] text-faint'>
                    <span>Juan Molina</span>
                    <time datetime={fecha.toISOString()}>{fechaLarga(fecha)}</time>
                    {actualizado && <span>Actualizado el <time datetime={actualizado.toISOString()}>{fechaLarga(actualizado)}</time></span>}
                    <span>{minutos} min de lectura</span>
                </p>
            </header>

            <div class='prosa mx-auto mt-10 max-w-[72ch]'>
                <Content />
            </div>

            <footer class='mx-auto mt-14 max-w-[72ch] space-y-6'>
                <section aria-labelledby='fuentes' class='card p-6 md:p-7'>
                    <h2 id='fuentes' class='font-mono text-[11px] uppercase tracking-[0.18em] text-muted'>Fuentes</h2>
                    <ul class='mt-4 space-y-2.5 text-[15px] leading-snug'>
                        {
                            fuentes.map((f) => (
                                <li>
                                    <a href={f.url} target='_blank' rel='noopener' class='text-ink underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-accent'>
                                        {f.titulo}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                    <p class='mt-5 text-[13px] leading-relaxed text-faint'>Entrada preparada con ayuda de IA a partir de las fuentes oficiales y revisada por mí antes de publicarla.</p>
                </section>

                {
                    etiquetas.length > 0 && (
                        <ul class='flex flex-wrap gap-2' aria-label='Etiquetas'>
                            {etiquetas.map((t) => (
                                <li class='chip'>{t}</li>
                            ))}
                        </ul>
                    )
                }

                <section class='card flex flex-col items-start gap-5 p-6 md:flex-row md:items-center md:justify-between md:p-7'>
                    <p class='max-w-[44ch] text-lg leading-snug'>¿No sabes si tu sitio o tu servidor está expuesto? <span class='text-muted'>Lo reviso y te digo qué corregir, desde {pesos.format(REVISION.planes[0].precio)}.</span></p>
                    <a href='/servicios/revision-seguridad/' class='btn-primary shrink-0'>Ver la revisión</a>
                </section>
            </footer>
        </article>

        {
            otras.length > 0 && (
                <aside aria-labelledby='mas-entradas' class='container-page mt-24'>
                    <h2 id='mas-entradas' class='kicker'>
                        Más del blog
                    </h2>
                    <ul class='mt-6 grid gap-4 md:grid-cols-2'>
                        {otras.map((o) => (
                            <li>
                                <a href={`/blog/${o.id}/`} class='card flex h-full flex-col p-6 md:p-7'>
                                    <span class='flex items-center justify-between gap-3 font-mono text-[11px] uppercase tracking-[0.14em] text-faint'>
                                        <span class='text-accent'>{CATEGORIAS[o.data.categoria]}</span>
                                        <time datetime={o.data.fecha.toISOString()}>{fechaLarga(o.data.fecha)}</time>
                                    </span>
                                    <span class='mt-4 text-xl font-semibold leading-snug tracking-[-0.02em]'>{o.data.titulo}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </aside>
            )
        }
    </main>
    <Footer pagina='blog' />
</Base>
