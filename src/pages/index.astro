---
import { Companion } from '@includes/views/Companion';
import { About } from '@components/views/inicio/views/About';
import { Blog } from '@components/views/inicio/views/Blog';
import { Contact } from '@components/views/inicio/views/Contact';
import { Footer } from '@components/views/inicio/views/Footer';
import { Github } from '@components/views/inicio/views/Github';
import { Hero } from '@components/views/inicio/views/Hero';
import { Metrics } from '@components/views/inicio/views/Metrics';
import { MoreProjects } from '@components/views/inicio/views/MoreProjects';
import { Navbar } from '@components/views/inicio/views/Navbar';
import { Projects } from '@components/views/inicio/views/Projects';
import { Services } from '@components/views/inicio/views/Services';
import { Skills } from '@components/views/inicio/views/Skills';
import Base from '@/layouts/Base.astro';
import { entradasPublicadas, resumen } from '@/lib/entradas';

const recientes = (await entradasPublicadas()).slice(0, 6);
const entradas = recientes.map(resumen);

// La portada cambia cuando entra o se actualiza una de las entradas que muestra; la fecha base cubre los cambios propios.
const modificada = new Date(Math.max(Date.parse('2026-10-28T00:00:00-05:00'), ...recientes.map((e) => (e.data.actualizado ?? e.data.fecha).getTime())));

const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebSite',
            '@id': 'https://juanmolina.dev/#website',
            url: 'https://juanmolina.dev/',
            name: 'Juan Molina',
            description: 'Portafolio de Juan Molina, desarrollador fullstack en Colombia.',
            inLanguage: 'es-CO',
            publisher: { '@id': 'https://juanmolina.dev/#persona' },
        },
        {
            '@type': 'ProfilePage',
            '@id': 'https://juanmolina.dev/#pagina',
            url: 'https://juanmolina.dev/',
            name: 'Juan Molina | Desarrollador Fullstack en Colombia',
            inLanguage: 'es-CO',
            isPartOf: { '@id': 'https://juanmolina.dev/#website' },
            mainEntity: { '@id': 'https://juanmolina.dev/#persona' },
            primaryImageOfPage: 'https://juanmolina.dev/images/og-image.jpg',
            dateModified: modificada.toISOString(),
        },
        {
            '@type': 'Person',
            '@id': 'https://juanmolina.dev/#persona',
            name: 'Juan Molina',
            jobTitle: 'Desarrollador Fullstack',
            url: 'https://juanmolina.dev/',
            image: 'https://juanmolina.dev/images/og-image.jpg',
            email: 'mailto:juan@mysoft.live',
            address: { '@type': 'PostalAddress', addressCountry: 'CO' },
            sameAs: ['https://github.com/OuisVN', 'https://www.instagram.com/juanmolinadev/'],
            knowsLanguage: ['es', 'en'],
            knowsAbout: ['Desarrollo web', 'Desarrollo de apps móviles', 'ERP', 'PHP', 'React', 'TypeScript', 'React Native', 'Expo', 'Node.js', 'MySQL', 'WhatsApp Cloud API', 'LiveKit', 'WebRTC', 'RustDesk', 'Wompi', 'Mercado Pago', 'Nginx', 'Debian', 'Proxmox'],
        },
        {
            '@type': 'ProfessionalService',
            '@id': 'https://juanmolina.dev/#servicio',
            name: 'Juan Molina, desarrollo de software a medida',
            url: 'https://juanmolina.dev/',
            image: 'https://juanmolina.dev/images/og-image.jpg',
            email: 'juan@mysoft.live',
            founder: { '@id': 'https://juanmolina.dev/#persona' },
            address: { '@type': 'PostalAddress', addressCountry: 'CO' },
            areaServed: { '@type': 'Country', name: 'Colombia' },
            hasOfferCatalog: {
                '@type': 'OfferCatalog',
                name: 'Servicios',
                itemListElement: [
                    { '@type': 'Offer', itemOffered: { '@id': 'https://juanmolina.dev/servicios/revision-seguridad/#servicio', '@type': 'Service', name: 'Revisión de seguridad de sitios web y servidores', url: 'https://juanmolina.dev/servicios/revision-seguridad/' } },
                    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Plataformas web y ERPs a medida' } },
                    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Apps móviles para iOS y Android' } },
                    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Integraciones con WhatsApp Cloud API, Instagram, Wompi y Mercado Pago' } },
                    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Migraciones y modernización de sistemas' } },
                    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Servidores y despliegue' } },
                ],
            },
        },
    ],
};
---

<Base title='Juan Molina | Desarrollador Fullstack en Colombia' description='Desarrollador fullstack en Colombia. Plataformas web, apps móviles iOS y Android, ERPs a medida e integraciones con WhatsApp y pagos en línea.' path='/' preload='/images/projects/inces.webp' jsonLd={jsonLd}>
    <a href='#contenido' class='sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-canvas'>Saltar al contenido</a>
    <!--
        Cada sección es su propia isla: el Hero se hidrata al cargar y el resto cuando se acerca a la pantalla,
        así el JavaScript de lo que está abajo no compite con la primera pintura. El pie no tiene interacción: va estático.
    -->
    <Navbar client:idle />
    <main id='contenido'>
        <Hero client:load />
        <Metrics client:visible={{ rootMargin: '300px' }} />
        <Projects client:visible={{ rootMargin: '300px' }} />
        <MoreProjects client:visible={{ rootMargin: '300px' }} />
        <Blog client:visible={{ rootMargin: '300px' }} entradas={entradas} />
        <Services client:visible={{ rootMargin: '300px' }} />
        <Skills client:visible={{ rootMargin: '300px' }} />
        <Github client:visible={{ rootMargin: '300px' }} />
        <About client:visible={{ rootMargin: '300px' }} />
        <Contact client:visible={{ rootMargin: '300px' }} />
    </main>
    <Footer />
    <!-- Michi depende del tamaño de la pantalla y de lo guardado en el navegador: solo existe en el cliente. -->
    <Companion client:only='react' />
</Base>
